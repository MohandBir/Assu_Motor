{% extends 'base.html.twig' %}

{% block title %}Profil{% endblock %}

{% block body %}

<h1 class="text-center my-4 mb-4">Mon Profil </h1>
<div class="text-center mb-4" >
    <img
        src="{{ asset('image/user-profile.png') }}"
        alt="Illustration"
        class="img-fluid w-50"
    >
</div>
<div class="pb-1">
    <table class="table tablle-responsive table-secondary">
        <tbody class="tab">
            <tr>
                <th scope="row">Nom</th>
                <td class="text-blue">{{ user.lname|upper }}</td>
            </tr>
            <tr>
                <th scope="row">Prénom</th>
                <td class="text-blue">{{ user.fname|capitalize }}</td>
            </tr>
            <tr>
                <th scope="row">Email</th>
                <td class="text-blue">{{ user.email }}</td>
            </tr>
        </tbody>      
    </table>
</div>
<div class="d-flex flex-column flex-sm-row justify-content-between gap-2 my-3 pb-2">
    <div class="w-100">
        <form action="{{ path('app_account_quote') }}" method="get" class="text-center">
            <button type="submit" class="btn btn btn-outline-blue w-75">mes devis</button>
        </form>  
    </div>
    <div class="w-100 text-sm-end"> 
        <form action="{{ path('app_account_subscription')}}" method="get" class="text-center">
            <button type="submit" class="btn btn btn-outline-blue  w-75">mes demandes</button>
        </form>    
    </div>
</div>

{% endblock %}