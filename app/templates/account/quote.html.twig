{% extends 'base.html.twig' %}

{% block title %}Mon espace{% endblock %}

{% block body %}
<div>
    <h1 class="text-center my-4">Mes devis</h1>

    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Vehicule</th>
                <th scope="col">Création</th>
                <th scope="col">Estimation</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            {% for quote in quotes %}
            <tr>
                <th scope="row">{{ quote.vehicle.model ~'/'~ quote.vehicle.vehicleyear}}</th>
                <td>{{ quote.createdAt|date('d-m-Y') }}</td>
                <td>{{ quote.EstimatedPrice / quote.duration }} €/mois</td>
                <td>
                    <a href="{{ path('app_quote_delete', {id: quote.id})}}">supprimer</a> 
                    <a href="{{ path('app_quote', {id: quote.id})}}">modifier</a>   
                </td>
            </tr>                
            {% endfor %}

           
        </tbody>
    </table>
</div>
{% endblock %}