{% extends 'base.html.twig' %}

{% block title %}Hello AdminSubscriptionController!{% endblock %}

{% block body %}
{# affichage des messages #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
    <div class="alert alert-dismissible alert-{{label}}">
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    <p class="text-center mb-0"> {{message}}</p>
    </div>
    {% endfor %}
{% endfor %}

<div class="w-75 bg-primary text-center mx-auto my-4 py-2 rounded-2">
    <span class=" fs-4 fw-semibold text-logo">Gestion des souscriptions</span>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr >
                <th scope="col" class="bg-gray3">Demandeur</th>
                <th scope="col" class="bg-gray3">Soumission</th>
                <th scope="col" class="bg-gray3">Status</th>
                <th scope="col" class="bg-gray3">Action</th>
            </tr>
        </thead>
        <tbody>
            {% for subscription in subscriptions %}
            <tr class="{{ loop.index % 2 ? 'table-info' : 'table-dark' }}">
                <th class="{{ loop.index % 2 ? 'text-blue' : 'text-logo' }}">
                        <a href="{{ path('app_admin_subscription_show', {id: subscription.id})}}"
                            class="text-decoration-none {{ loop.index % 2 ? 'text-blue' : 'text-logo' }}">
                        {{subscription.user.fname|capitalize ~ ' ' ~ subscription.user.lname|capitalize}}
                        </a>
                    </th>
               
                <th class="{{ loop.index % 2 ? 'text-blue' : 'text-logo' }}">
                    <div class="d-block d-md-inline">{{ subscription.submittedAt|date(' d-m-Y ') }}<span
                            class="d-none d-md-inline">|</span></div>
                    <div class="d-inline">{{ subscription.submittedAt|date('H:i') }} </div>
                </th>
                <th class="{{ loop.index % 2 ? 'text-blue' : 'text-logo' }}">
                    {{subscription.translatedStatus}}
                </th>
                <th class="{{ loop.index % 2 ? 'text-blue' : 'text-logo' }}">
                    <div class="dropdown">
                        <button class="dropdown-toggle btn {{ loop.index % 2 ? 'text-blue' : 'text-logo' }}"
                                data-bs-toggle="dropdown" href="#">
                            Procéder
                        </button>
                        <div class="dropdown-menu dropdown-menu-end {{ loop.index % 2 ? 'bg-info' : 'bg-gray7' }}">
                            <form action="{{ path('app_admin_subscription_show', {id: subscription.id})}}" method="get">
                                <button type="submit" class="dropdown-item fw-semibold {{ loop.index % 2 ? 'text-blue' : 'text-warning' }} ">
                                    Examiner
                                </button>
                            </form>
                            {% if subscription.status != constant('VALIDATED', subscription) %}
                            <button  class="dropdown-item fw-semibold text-danger }}"
                                data-bs-toggle="modal" 
                                data-bs-target="#deleteModal-{{ subscription.id }}"
                                style="max-width:min-content">
                                supprimer
                            </button>
                            {% endif %}
                        </div>
                    </div>
                    {% if subscription.status != constant('VALIDATED', subscription) %}
                    <div class="modal fade" id="deleteModal-{{ subscription.id }}" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h5 class="modal-title text-warning">Suppression</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                {% if not subscription.processedAt %}
                                <div class="modal-body text-danger">
                                    ⚠️ Attention, cette demande n'est pas encore examinée!! 
                                </div>
                                {% endif %}
                                <div class="modal-body text-start">
                                    Êtes-vous sûr de vouloir supprimer cette demande?
                                </div>

                                <div class="modal-footer">
                                    <form action="{{ path('app_admin_subscription_delete', {id: subscription.id}) }}" method="post">
                                        <input type="hidden" name="token"
                                            value="{{ csrf_token('delete-subscription' ~ subscription.id) }}">
                                        <button class="btn btn-blue">Supprimer</button>
                                    </form>
                                    <button class="btn btn-secondary" data-bs-dismiss="modal">
                                        Annuler
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %} 
                </th>

            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}