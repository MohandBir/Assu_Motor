{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

<main class="">
    <div class="text-center my-3 ">
        <h1 class="fw-semibold">Pourquoi choisir Assu Motor ?</h1>
    </div>
    <div class="row mt-5">

        <div class="col">
            <div class="card border-2 border-blue mb-3" style="max-width: 25rem;">
                <div class="card-header text-center">💰</div>
                <div class="card-body" style="min-height: 215.25px">
                    <h4 class="card-title">Tarifs compétitifs</h4>
                    <p class="card-text">Des offres adaptées à votre budget, sans frais cachés.</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-2 border-blue mb-3" style="max-width: 25rem;">
                <div class="card-header text-center">⚡</div>
                <div class="card-body" style="min-height: 215.25px">
                    <h4 class="card-title"> Devis en 2 minutes</h4>
                    <p class="card-text">Une simulation rapide, 100 % en ligne, sans engagement.</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-2 border-blue mb-3" style="max-width: 25rem;">
                <div class="card-header text-center">🛡️</div>
                <div class="card-body" style="min-height: 215.25px">
                    <h4 class="card-title">Couverture adaptée</h4>
                    <p class="card-text">Trois formules pour répondre à tous vos besoins : Tiers, Tiers+, Tous risques</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-2 border-blue mb-3" style="max-width: 25rem;">
                <div class="card-header text-center ">📞</div>
                <div class="card-body" style="min-height: 215.25px">
                    <h4 class="card-title">Conseillers à l'écoute</h4>
                    <p class="card-text">Une équipe disponible du lundi au samedi pour vous accompagner.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center mt-3">
        <a href="" class=" btn btn-blue text-logo w-75"> Faire un Devis</a>
    </div>
</main>

{% endblock %}